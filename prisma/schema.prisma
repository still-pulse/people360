generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  SUPERINTENDENT
  GERENTE
  JURIDICO
}

enum ChamadoStatus {
  ABERTO
  EM_ANDAMENTO
  PENDENTE
  RESOLVIDO
  FECHADO
}

enum ChamadoPrioridade {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum TipoSolicitacao {
  /// Registrar hora extra / ficar até mais tarde (crédito no banco)
  HORAS_EXTRAS
  /// Usar saldo do banco / sair mais cedo ou compensar (débito)
  BANCO_HORAS
  FOLGA
  /// Ausência de dia inteiro (atestado, falta)
  AUSENCIA
  /// Saída por algumas horas no mesmo dia (consulta, exame etc.) — não conta como dia de ausência
  AUSENCIA_PARCIAL
}

enum AprovacaoStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  WAITING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EventType {
  PROCESSO_SELETIVO
  REUNIAO
  TREINAMENTO
  VISITA
  OUTRO
}

enum VagaStatus {
  PENDENTE_APROVACAO
  REJEITADA
  ABERTA
  DIVULGACAO
  TRIAGEM
  ENTREVISTAS
  ENCAMINHADA_GESTOR
  APROVADA_CONTRATACAO
  ADMISSAO_EM_ANDAMENTO
  CONTRATADA
  FECHADA
  CANCELADA
}

enum AprovacaoTipo {
  SOLICITACAO_INFO
  RESPOSTA
  APROVACAO
  REJEICAO
}

enum TipoVaga {
  EFETIVO
  TEMPORARIO
  ESTAGIO
  PJ
  OUTROS
}

enum PeriodoTrabalho {
  DIURNO
  NOTURNO
  MISTO
  PLANTAO
}

enum TipoRequisicao {
  SUBSTITUICAO
  AUMENTO_QUADRO
}

enum TipoContrato {
  DETERMINADO
  INDETERMINADO
}

enum TipoRecrutamento {
  INTERNO
  EXTERNO
}

enum CandidatoStatus {
  EM_PROCESSO
  APROVADO
  AGUARDANDO_ADMISSAO
  ADMITIDO
  DESISTENTE
  REPROVADO
}

enum ControleCandidatoStatus {
  REPROVADO
  BANCO_TALENTOS
  CONTRATADO
  DESISTIU
}

enum DocumentoLinkStatus {
  ATIVO
  EXPIRADO
  CONCLUIDO
  REVOGADO
}

enum DocumentoItemStatus {
  PENDENTE
  ENVIADO
  APROVADO
  REJEITADO
}

enum ParecerResultado {
  APROVADO
  APROVADO_COM_RESTRICOES
  REPROVADO
  BANCO_TALENTOS
}

enum TipoVinculoParecer {
  CLT
  ESTAGIO
  APRENDIZ
  PCD
}

enum AdmissionStatus {
  DRAFT
  LINK_SENT
  IN_PROGRESS
  AWAITING_DOCUMENTS
  DOCUMENTS_UNDER_REVIEW
  CORRECTION_REQUESTED
  DOCUMENTS_APPROVED
  FACE_VALIDATION_PENDING
  CONTRACT_PENDING
  SIGNATURE_PENDING
  SIGNED
  READY_FOR_ERPNEXT
  SYNCING
  SYNCED
  ERPNEXT_ERROR
  COMPLETED
  CANCELLED
  EXPIRED
}

enum AdmissionDocumentStatus {
  PENDING
  UPLOADED
  PROCESSING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  EXPIRED
  DELETED
}

enum AdmissionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FaceVerificationStatus {
  NOT_STARTED
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  MANUAL_REVIEW
  ERROR
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  SENT
  SIGNED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SignatureEnvelopeStatus {
  CREATED
  SENT
  VIEWED
  AUTHENTICATED
  SIGNED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ERPNextSyncStatus {
  WAITING
  PROCESSING
  SUCCESS
  ERROR
  RETRYING
}

enum AdmissionTourProgressStatus {
  STARTED
  SKIPPED
  COMPLETED
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  password           String
  role               Role     @default(ANALYST)
  active             Boolean  @default(true)
  unitId             String?
  phone              String?
  jobTitle           String?
  bio                String?
  avatarUrl          String?
  mfaSecret          String?
  mfaEnabled         Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  unit                       Unit?                      @relation(fields: [unitId], references: [id])
  calendarEvents             CalendarEvent[]
  tasksCreated               Task[]                     @relation("TaskCreator")
  taskResponsibles           TaskResponsible[]          @relation("TaskResponsibles")
  taskComments               TaskComment[]
  taskHistories              TaskHistory[]
  vagas                      Vaga[]
  vagaHistorico              VagaHistorico[]
  vagaAcompanhamentos        VagaAcompanhamento[]       @relation("VagaAcompanhamentos")
  vagaAprovacaoComentarios   VagaAprovacaoComentario[]
  controleCandidatos         ControleCandidato[]
  candidatosSnapshots        CandidatosMonthSnapshot[]  @relation("SnapshotCreatedBy")
  notifications              Notification[]
  eventParticipations        CalendarEventParticipant[]
  chamadosAbertos            Chamado[]                  @relation("ChamadoAutor")
  chamadosAtribuidos         Chamado[]                  @relation("ChamadoAtribuido")
  chamadoMensagens           ChamadoMensagem[]          @relation("ChamadoMensagens")
  chamadosAprovados          Chamado[]                  @relation("ChamadoAprovador")
  pcdEvidencias              PcdEvidencia[]             @relation("PcdEvidenciaCreatedBy")
  managedUnits               UserUnit[]
  documentoLinksCriados      DocumentoLink[]            @relation("DocumentoLinkCreatedBy")
  documentoItensRevisados    DocumentoLinkItem[]        @relation("DocumentoItemRevisor")
  pareceresElaborados        Parecer[]                  @relation("ParecerElaborador")
  testeConvitesCriados       TesteConvite[]             @relation("TesteConviteCreatedBy")
  admissionsOwned            Admission[]                @relation("AdmissionOwner")
  admissionsCreated          Admission[]                @relation("AdmissionCreatedBy")
  admissionDocumentsReviewed AdmissionDocument[]        @relation("AdmissionDocumentReviewer")
  admissionAuditLogs         AdmissionAuditLog[]
  admissionTourProgress      AdmissionTourProgress[]
  admissionTourEvents        AdmissionTourEvent[]

  @@map("users")
}

model Unit {
  id                  String   @id @default(cuid())
  name                String   @unique
  color               String   @default("#15AFA4")
  description         String?
  active              Boolean  @default(true)
  exibirIndicadores   Boolean  @default(true)
  /// Último mês em que a unidade entra no indicador (ex.: jul/2026). Null = sem limite.
  indicadoresAteYear  Int?
  indicadoresAteMonth Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                        User[]
  calendarEvents               CalendarEvent[]
  tasks                        Task[]
  pcdIndicators                PCDIndicator[]
  apprenticeIndicators         ApprenticeIndicator[]
  turnoverIndicators           TurnoverIndicator[]
  absenteeismIndicators        AbsenteeismIndicator[]
  headcountEntries             HeadcountEntry[]
  vagas                        Vaga[]
  chamados                     Chamado[]
  engagementIndicators         EngagementIndicator[]
  npsIndicators                NpsIndicator[]
  payrollIndicators            PayrollIndicator[]
  hiringCostIndicators         HiringCostIndicator[]
  tenureDistributionIndicators TenureDistributionIndicator[]
  trainingIndicators           TrainingIndicator[]
  pcdEvidencias                PcdEvidencia[]
  pcdWeeklySnapshots           PcdWeeklySnapshot[]
  managedByUsers               UserUnit[]
  pareceres                    Parecer[]
  colaboradores                Colaborador[]
  admissions                   Admission[]
  admissionDocumentTypes       AdmissionDocumentType[]

  @@map("units")
}

// ─── Colaboradores (espelho Employee ERPNext) ────────────────────────────────

model Colaborador {
  id              String    @id @default(cuid())
  /// Employee.name no ERPNext (ex.: RH-COLAB-00532 ou nome)
  erpnextId       String    @unique
  employeeName    String
  status          String    @default("Active")
  company         String?
  department      String?
  designation     String?
  cellNumber      String?
  personalEmail   String?
  companyEmail    String?
  dateOfJoining   DateTime?
  dateOfBirth     DateTime?
  gender          String?
  reportsTo       String?
  reportsToName   String?
  imagePath       String?
  employmentType  String?
  relievingDate   DateTime?
  matricula       String?
  cpf             String?
  rg              String?
  secao           String?
  pcd             Boolean   @default(false)
  tipoDeficiencia String?
  etnia           String?
  cargaHoraria    String?
  naturalidade    String?
  unitId          String?
  erpnextModified DateTime?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  unit Unit? @relation(fields: [unitId], references: [id])

  perfil      ColaboradorPerfil?
  documentos  ColaboradorDocumento[]
  aditivos    ColaboradorAditivo[]
  dependentes ColaboradorDependente[]
  avaliacoes  ColaboradorAvaliacao[]
  historico   ColaboradorHistorico[]

  @@index([status])
  @@index([company])
  @@index([designation])
  @@index([employeeName])
  @@index([unitId])
  @@map("colaboradores")
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  pauta       String?
  meetingLink String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean   @default(false)
  eventType   EventType @default(OUTRO)
  reminders   Int[]     @default([15, 5])
  unitId      String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  unit         Unit?                      @relation(fields: [unitId], references: [id])
  user         User                       @relation(fields: [userId], references: [id])
  participants CalendarEventParticipant[]

  @@map("calendar_events")
}

model CalendarEventParticipant {
  eventId String
  userId  String

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("calendar_event_participants")
}

model Competencia {
  id        String   @id @default(cuid())
  mes       Int
  ano       Int
  createdAt DateTime @default(now())
  tasks     Task[]

  @@unique([mes, ano])
  @@map("competencias")
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus   @default(BACKLOG)
  priority      TaskPriority @default(MEDIUM)
  position      Int          @default(0)
  dueDate       DateTime?
  createdById   String?
  unitId        String?
  competenciaId String?
  chamadoId     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy    User?             @relation("TaskCreator", fields: [createdById], references: [id])
  unit         Unit?             @relation(fields: [unitId], references: [id])
  competencia  Competencia?      @relation(fields: [competenciaId], references: [id])
  chamado      Chamado?          @relation(fields: [chamadoId], references: [id])
  comments     TaskComment[]
  history      TaskHistory[]
  responsibles TaskResponsible[]

  @@index([chamadoId])
  @@map("tasks")
}

model TaskResponsible {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskResponsibles", fields: [userId], references: [id])

  @@id([taskId, userId])
  @@map("task_responsibles")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

model TaskHistory {
  id         String     @id @default(cuid())
  taskId     String
  userId     String
  fromStatus TaskStatus
  toStatus   TaskStatus
  createdAt  DateTime   @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_histories")
}

model PCDIndicator {
  id             String   @id @default(cuid())
  unitId         String
  year           Int
  month          Int
  totalEmployees Int
  metaPercentage Float    @default(5)
  currentPcd     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, year, month])
  @@map("pcd_indicators")
}

model PcdWeeklySnapshot {
  id             String   @id @default(cuid())
  unitId         String
  year           Int
  month          Int
  weekDate       DateTime
  totalEmployees Int
  metaPercentage Float    @default(5)
  currentPcd     Int      @default(0)
  createdAt      DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, weekDate])
  @@index([year, month])
  @@map("pcd_weekly_snapshots")
}

model ApprenticeIndicator {
  id             String   @id @default(cuid())
  unitId         String
  year           Int
  month          Int
  totalEmployees Int
  requiredCount  Int      @default(0)
  currentCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, year, month])
  @@map("apprentice_indicators")
}

model TurnoverIndicator {
  id             String   @id @default(cuid())
  unitId         String
  year           Int
  month          Int
  admissions     Int      @default(0)
  dismissals     Int      @default(0)
  headcountStart Int      @default(0)
  headcountEnd   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, year, month])
  @@map("turnover_indicators")
}

model AbsenteeismIndicator {
  id                 String   @id @default(cuid())
  unitId             String
  year               Int
  month              Int
  totalCertificates  Int      @default(0)
  totalDaysLost      Int      @default(0)
  totalEmployees     Int      @default(0)
  workingDaysInMonth Int      @default(22)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, year, month])
  @@map("absenteeism_indicators")
}

model Position {
  id            String   @id @default(cuid())
  name          String   @unique
  codigoInterno String?
  categoria     String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  headcountEntries HeadcountEntry[]
  vagas            Vaga[]           @relation("VagaCargo")
  aliases          CargoAlias[]

  @@map("positions")
}

model CargoAlias {
  id         String   @id @default(cuid())
  positionId String
  alias      String   @unique
  createdAt  DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@map("cargo_aliases")
}

model HeadcountEntry {
  id         String   @id @default(cuid())
  unitId     String
  positionId String
  year       Int
  month      Int
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit     Unit     @relation(fields: [unitId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  @@unique([unitId, positionId, year, month])
  @@map("headcount_entries")
}

// ─── Chamados Internos ───────────────────────────────────────────────────────

model Chamado {
  id                     String            @id @default(cuid())
  titulo                 String
  descricao              String
  status                 ChamadoStatus     @default(ABERTO)
  prioridade             ChamadoPrioridade @default(NORMAL)
  categoria              String            @default("Outros")
  autorId                String
  atribuidoId            String?
  unitId                 String?
  resolvidoAt            DateTime?
  tipoSolicitacao        TipoSolicitacao?
  aprovacaoStatus        AprovacaoStatus?
  dataInicio             DateTime?
  dataFim                DateTime?
  /// Horário de entrada no dia da solicitação (HH:mm) — obrigatório em HORAS_EXTRAS / BANCO_HORAS
  horaEntrada            String?
  /// Horário de saída no dia da solicitação (HH:mm) — obrigatório em HORAS_EXTRAS / BANCO_HORAS
  horaSaida              String?
  horasSolicitadas       Float?
  aprovacaoJustificativa String?
  aprovadoPorId          String?
  aprovadoAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  autor       User              @relation("ChamadoAutor", fields: [autorId], references: [id])
  atribuido   User?             @relation("ChamadoAtribuido", fields: [atribuidoId], references: [id])
  unit        Unit?             @relation(fields: [unitId], references: [id])
  mensagens   ChamadoMensagem[]
  aprovadoPor User?             @relation("ChamadoAprovador", fields: [aprovadoPorId], references: [id])
  tasks       Task[]

  @@index([autorId])
  @@index([status])
  @@index([tipoSolicitacao])
  @@index([aprovacaoStatus])
  @@map("chamados")
}

model ChamadoMensagem {
  id        String   @id @default(cuid())
  chamadoId String
  autorId   String
  conteudo  String
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  chamado Chamado        @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autor   User           @relation("ChamadoMensagens", fields: [autorId], references: [id])
  anexos  ChamadoAnexo[]

  @@index([chamadoId])
  @@map("chamado_mensagens")
}

model ChamadoAnexo {
  id         String   @id @default(cuid())
  mensagemId String
  nome       String
  url        String
  tamanho    Int
  tipo       String
  createdAt  DateTime @default(now())

  mensagem ChamadoMensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  @@map("chamado_anexos")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  userRole   String?
  action     String
  entity     String
  entityId   String?
  entityName String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Notificações ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ─── Logs de E-mail ───────────────────────────────────────────────────────────

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  status    String
  response  String?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

// ─── Configurações do Sistema ────────────────────────────────────────────────

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ─── Módulo de Controle de Vagas ─────────────────────────────────────────────

model Vaga {
  id                     String            @id @default(cuid())
  titulo                 String
  unidadeId              String?
  municipio              String?
  cargo                  String
  setor                  String?
  quantidade             Int               @default(1)
  tipoVaga               TipoVaga          @default(EFETIVO)
  periodoTrabalho        PeriodoTrabalho?
  cargaHoraria           String?
  horarioTrabalho        String?
  escala                 String?
  plantaoColaboradorSaiu String?
  salarioMin             Float?
  salarioMax             Float?
  tipoRequisicao         TipoRequisicao?
  tipoContrato           TipoContrato?
  tipoRecrutamento       TipoRecrutamento?
  nomeColaboradorSaiu    String?
  nomeColaborador        String?
  disponibilidadeHorario String?
  vagaPcd                Boolean           @default(false)
  gestorRequisitante     String?
  setorRequisitante      String?
  numProcessoAdmissao    String?
  numProtocoloOnvio      String?
  /// ID da Job Requisition no ERPNext (ex.: RP-2026-00117). Unique para idempotência de sync.
  requisicaoNextId       String?           @unique
  /// Último status lido do ERPNext (Pending, Open & Approved, Rejected, …)
  erpnextStatus          String?
  /// Timestamp do último sync com o ERPNext
  erpnextSyncedAt        DateTime?
  cargoId                String?
  controleCandidatoId    String?           @unique
  dataAbertura           DateTime          @default(now())
  dataPrevistaFechamento DateTime?
  dataFechamento         DateTime?
  dataInicioIntegracao   DateTime?
  status                 VagaStatus        @default(ABERTA)
  observacoes            String?
  position               Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  unit                 Unit?                     @relation(fields: [unidadeId], references: [id])
  analistas            User[]
  cargo_rel            Position?                 @relation("VagaCargo", fields: [cargoId], references: [id])
  controleCandidato    ControleCandidato?        @relation("VagaAprovado", fields: [controleCandidatoId], references: [id], onDelete: SetNull)
  candidatos           Candidato[]
  historico            VagaHistorico[]
  acompanhamentos      VagaAcompanhamento[]
  aprovacaoComentarios VagaAprovacaoComentario[]
  documentoLinks       DocumentoLink[]
  admissions           Admission[]

  @@index([cargoId])
  @@index([status])
  @@map("vagas")
}

model VagaAcompanhamento {
  id      String   @id @default(cuid())
  vagaId  String
  userId  String
  data    DateTime @default(now())
  decisao String
  notas   String?

  vaga Vaga @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  user User @relation("VagaAcompanhamentos", fields: [userId], references: [id])

  @@index([vagaId])
  @@map("vaga_acompanhamentos")
}

model Candidato {
  id             String          @id @default(cuid())
  vagaId         String
  nome           String
  telefone       String?
  email          String?
  dataAprovacao  DateTime?
  status         CandidatoStatus @default(EM_PROCESSO)
  observacoes    String?
  cvFileName     String?
  cvOriginalName String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  vaga           Vaga            @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  documentoLinks DocumentoLink[]
  admissions     Admission[]

  @@map("candidatos")
}

model VagaHistorico {
  id         String      @id @default(cuid())
  vagaId     String
  userId     String?
  fromStatus VagaStatus?
  toStatus   VagaStatus?
  descricao  String?
  createdAt  DateTime    @default(now())

  vaga Vaga  @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@map("vaga_historico")
}

model VagaAprovacaoComentario {
  id        String        @id @default(cuid())
  vagaId    String
  userId    String
