  cnpj                String             @default("50.351.626/0001-10")
  unitId              String?
  controleCandidatoId String?
  candidatoNome       String
  cargo               String
  dataAvaliacao       DateTime
  idade               Int?
  tipoVinculo         TipoVinculoParecer @default(CLT)

  /// Traços comportamentais da apresentação (checkboxes)
  apresentacao   String[] @default([])
  /// Verbalização (checkboxes)
  verbalizacao   String[] @default([])
  /// Técnicas utilizadas (checkboxes)
  tecnicas       String[] @default([])
  tecnicasOutros String?

  /// Perfil comportamental 0–100 (lado direito do espectro, estilo 16personalities)
  traitEI Int @default(50) // Extravertido (0) ↔ Introvertido (100)
  traitNS Int @default(50) // Intuitivo (0) ↔ Observador (100)
  traitTF Int @default(50) // Pensamento (0) ↔ Sentimento (100)
  traitJP Int @default(50) // Julgamento (0) ↔ Prospecção (100)
  traitAT Int @default(50) // Assertivo (0) ↔ Turbulento (100)

  /// Competências de suporte 1–5: { chave: nota }
  competencias Json @default("{}")

  analiseTexto   String?
  resultado      ParecerResultado?
  dataAssinatura DateTime?
  elaboradorId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit              Unit?              @relation(fields: [unitId], references: [id])
  elaborador        User?              @relation("ParecerElaborador", fields: [elaboradorId], references: [id])
  controleCandidato ControleCandidato? @relation(fields: [controleCandidatoId], references: [id], onDelete: SetNull)

  @@index([candidatoNome])
  @@index([controleCandidatoId])
  @@index([dataAvaliacao])
  @@index([resultado])
  @@map("pareceres")
}

// ─── Testes comportamentais (Big Five / DISC) ────────────────────────────────

enum TipoTeste {
  BIG_FIVE
  DISC
}

enum TesteConviteStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  EXPIRADO
  REVOGADO
}

/// Convite/link personalizado para o candidato ou colaborador realizar o teste.
model TesteConvite {
  id                  String             @id @default(cuid())
  token               String             @unique
  tipo                TipoTeste
  status              TesteConviteStatus @default(PENDENTE)
  nome                String
  email               String?
  cargo               String?
  telefone            String?
  controleCandidatoId String?
  createdById         String
  expiresAt           DateTime
  enviadoAt           DateTime?
  iniciadoAt          DateTime?
  concluidoAt         DateTime?
  observacoes         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  createdBy         User               @relation("TesteConviteCreatedBy", fields: [createdById], references: [id])
  controleCandidato ControleCandidato? @relation(fields: [controleCandidatoId], references: [id], onDelete: SetNull)
  resultado         TesteResultado?

  @@index([tipo])
  @@index([status])
  @@index([nome])
  @@index([createdById])
  @@index([controleCandidatoId])
  @@map("teste_convites")
}

/// Resultado calculado no servidor (visível apenas para ADMIN no dashboard).
model TesteResultado {
  id                 String   @id @default(cuid())
  conviteId          String   @unique
  /// Big Five: { E,A,C,N,O: { raw, max, pct, level } }
  /// DISC: { scores: {D,I,S,C}, pcts, perfil, perfilSecundario? }
  scores             Json
  /// Respostas brutas (auditoria / reprocessamento)
  answers            Json
  perfilPredominante String?
  completedAt        DateTime @default(now())
  createdAt          DateTime @default(now())

  convite TesteConvite @relation(fields: [conviteId], references: [id], onDelete: Cascade)

  @@index([completedAt])
  @@map("teste_resultados")
}

// ─── Dossiê do Colaborador ───────────────────────────────────────────────────

enum ColaboradorDocumentoStatus {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ASSINADO
  VIGENTE
  FINALIZADO
  CANCELADO
}

enum ColaboradorDocumentoOrigem {
  GERADO
  ANEXADO
}

/// Complemento cadastral 1:1 do colaborador (o espelho do ERPNext não traz estes dados).
/// `sensivel` guarda, criptografado (AES-256-GCM): salário, PIS, CTPS, dados bancários e endereço.
model ColaboradorPerfil {
  id            String   @id @default(cuid())
  colaboradorId String   @unique
  admissionId   String?
  nomeSocial    String?
  funcao        String?
  cbo           String?
  centroCusto   String?
  sindicato     String?
  jornada       String?
  escala        String?
  horario       String?
  localTrabalho String?
  estadoCivil   String?
  nacionalidade String?
  escolaridade  String?
  nomeMae       String?
  nomePai       String?
  rgOrgao       String?
  rgUf          String?
  rgEmissao     String?
  sensivel      Json?
  atualizadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@map("colaborador_perfis")
}

/// Documentos funcionais (gerados a partir de template ou anexados). Nunca são apagados: apenas cancelados.
/// `snapshot` congela os dados do colaborador no momento da geração e nunca é reescrito.
model ColaboradorDocumento {
  id                 String                     @id @default(cuid())
  colaboradorId      String
  tipo               String
  categoria          String
  titulo             String
  origem             ColaboradorDocumentoOrigem @default(GERADO)
  status             ColaboradorDocumentoStatus @default(RASCUNHO)
  versao             Int                        @default(1)
  templateKey        String?
  templateVersion    Int?
  dados              Json?
  snapshot           Json?
  assinaturas        Json?
  vigenciaInicio     DateTime?
  vigenciaFim        DateTime?
  observacao         String?
  arquivoPath        String?
  arquivoNome        String?
  arquivoMime        String?
  arquivoTamanho     Int?
  hash               String?
  /// Origem quando importado da admissão digital ("doc:<id>" ou "gen:<id>"); evita importar duas vezes.
  admissaoOrigemId   String?
  origemDocumentoId  String?
  criadoPorId        String?
  criadoPorNome      String?
  geradoEm           DateTime?
  canceladoEm        DateTime?
  canceladoPorNome   String?
  motivoCancelamento String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  colaborador Colaborador         @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  aditivo     ColaboradorAditivo?

  @@unique([colaboradorId, admissaoOrigemId])
  @@index([colaboradorId, tipo])
  @@index([colaboradorId, createdAt])
  @@map("colaborador_documentos")
}

/// Aditivos contratuais. Cada aditivo é um registro novo; nenhum sobrescreve o anterior.
model ColaboradorAditivo {
  id            String   @id @default(cuid())
  colaboradorId String
  documentoId   String?  @unique
  numero        Int
  tipoAlteracao String
  campoAlterado String
  valorAnterior String?
  valorNovo     String
  vigencia      DateTime
  motivo        String
  clausulas     String?
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime @default(now())

  colaborador Colaborador           @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  documento   ColaboradorDocumento? @relation(fields: [documentoId], references: [id])

  @@index([colaboradorId, vigencia])
  @@map("colaborador_aditivos")
}

model ColaboradorDependente {
  id             String    @id @default(cuid())
  colaboradorId  String
  nome           String
  cpfMascarado   String?
  cpfCifrado     Json?
  nascimento     DateTime
  parentesco     String
  sexo           String?
  dependenteIr   Boolean   @default(false)
  salarioFamilia Boolean   @default(false)
  planoSaude     Boolean   @default(false)
  inclusaoEm     DateTime  @default(now())
  exclusaoEm     DateTime?
  criadoPorNome  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, exclusaoEm])
  @@map("colaborador_dependentes")
}

/// Avaliações do período de experiência (gerencial e autoavaliação). `modelo` congela os critérios usados.
model ColaboradorAvaliacao {
  id            String    @id @default(cuid())
  colaboradorId String
  tipo          String
  periodoDias   Int?
  periodoInicio DateTime?
  periodoFim    DateTime?
  avaliadorNome String?
  respostas     Json
  modelo        Json
  snapshot      Json
  parecer       String?
  decisao       String?
  observacoes   String?
  dataAvaliacao DateTime
  status        String    @default("RASCUNHO")
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, tipo])
  @@map("colaborador_avaliacoes")
}

/// Linha do tempo funcional (append-only): salário, cargo, jornada, unidade, contratos, avaliações…
model ColaboradorHistorico {
  id              String   @id @default(cuid())
  colaboradorId   String
  tipo            String
  dataEvento      DateTime
  titulo          String
  anterior        String?
  novo            String?
  motivo          String?
  documentoId     String?
  aditivoId       String?
  responsavelId   String?
  responsavelNome String?
  createdAt       DateTime @default(now())

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, dataEvento])
  @@index([colaboradorId, tipo])
  @@map("colaborador_historico")
}
