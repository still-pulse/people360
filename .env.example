# People 360 — copie para .env e preencha (NUNCA commitar o .env)
# cp .env.example .env

POSTGRES_DB=gestaorh
POSTGRES_USER=gestaorh
POSTGRES_PASSWORD=altere-esta-senha

# Em Docker Compose use host "db"; em dev local use "localhost"
DATABASE_URL=postgresql://gestaorh:altere-esta-senha@db:5432/gestaorh?client_encoding=UTF8

NEXTAUTH_SECRET=gere-um-segredo-longo-e-aleatorio
NEXTAUTH_URL=https://people360.ossbhcl.org.br

# Integração Treinamentos (opcional)
BHCL_TRAINING_API_URL=
BHCL_TRAINING_API_KEY=

# Integração ERPNext (opcional)
# User dedicado com role HR Manager (approve/reject JR) + read Employee
ERPNEXT_BASE_URL=https://sistema.ossbhcl.org.br
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Módulos de sync (default true se KEY/SECRET estiverem preenchidos)
ERPNEXT_JR_SYNC_ENABLED=true
ERPNEXT_EMPLOYEE_SYNC_ENABLED=true
# Cron único hora em hora (America/Sao_Paulo) — minuto 5 de cada hora
# Formato cron: "min hora dia mês dia-semana" → "5 * * * *" = todo horário às :05
ERPNEXT_SYNC_CRON=5 * * * *
# true = roda um sync completo ~15s após o container subir
ERPNEXT_SYNC_ON_BOOT=false
# Secret opcional para chamar endpoints de sync via ?secret=
# CRON_SECRET=

# SMTP (opcional — vazio desativa e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=People 360 <noreply@example.com>

# Slack Incoming Webhook (opcional)
SLACK_WEBHOOK_URL=

# Admissão Digital (providers mock permitem o fluxo local completo)
ADMISSION_STORAGE_PATH=
ADMISSION_MAX_FILE_SIZE=15728640
ADMISSION_RETENTION_DAYS=3650
ADMISSION_DATA_PEPPER=gere-um-segredo-diferente-do-token
FACE_VERIFICATION_PROVIDER=mock
SIGNATURE_PROVIDER=mock
ADMISSION_ERPNEXT_PROVIDER=mock
ADMISSION_NOTIFICATION_PROVIDER=mock
MOCK_FACE_RESULT=approve
VT_DECLARATION_VERSION=v1
# true apenas em ambiente local para criar uma admissão demonstrativa
ADMISSION_SEED_DEMO=false
